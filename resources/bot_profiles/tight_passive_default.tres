[gd_resource type="Resource" script_class="BotProfile" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/core/agents/bot_profile.gd" id="1_profile"]
[ext_resource type="Script" path="res://scripts/core/agents/tight_passive_decision_model_parameters.gd" id="2_params"]

[sub_resource type="Resource" id="TightPassiveParameters_default"]
script = ExtResource("2_params")
minimum_preflop_high_rank = 10
raise_frequency = 5

[resource]
script = ExtResource("1_profile")
profile_id = &"tight_passive_default"
model_id = &"tight_passive"
display_name = "Tight Passive"
parameters = SubResource("TightPassiveParameters_default")
